# Copy to .env in the repo root (Windows: copy env.example .env) – read by the backend, Prisma and the embedded database launcher.
# Embedded PostgreSQL (npm run db:start) listens on 5433 so it never clashes with a real install.
DATABASE_URL=postgresql://devflow:devflow@localhost:5433/devflow

# Backend
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000
# Exposes POST /api/test/reset for automated tests. NEVER enable in production.
ENABLE_TEST_ROUTES=true
LOGIN_RATE_LIMIT=1000

# AI triage: "mock" (default, deterministic, offline) or "claude" (needs ANTHROPIC_API_KEY)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_TIMEOUT_MS=15000

# Frontend → backend (used by Next.js rewrites at build time)
BACKEND_URL=http://localhost:4000
