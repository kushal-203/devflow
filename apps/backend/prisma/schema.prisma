// DevFlow data model – PostgreSQL via Prisma ORM 7 (TypeScript client, pg driver adapter).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  QA
  DEVELOPER
  VIEWER
}

enum IssueStatus {
  BACKLOG
  IN_PROGRESS
  QA
  DONE
  VERIFIED
}

enum IssueType {
  BUG
  STORY
  TASK
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum TestCaseSource {
  AI
  MANUAL
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  name           String
  passwordHash   String
  role           Role         @default(DEVELOPER)
  createdAt      DateTime     @default(now())
  reported       Issue[]      @relation("IssueReporter")
  assigned       Issue[]      @relation("IssueAssignee")
  events         IssueEvent[]
}

model Project {
  id          String   @id @default(uuid())
  key         String   @unique // short code used in issue keys, e.g. "DF" -> DF-12
  name        String
  description String   @default("")
  issueSeq    Int      @default(0) // last issue number handed out (per-project sequence)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sprints     Sprint[]
  issues      Issue[]
}

model Sprint {
  id        String       @id @default(uuid())
  projectId String
  name      String
  goal      String       @default("")
  status    SprintStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime     @default(now())
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@unique([projectId, name])
  @@index([projectId, status])
}

model Issue {
  id                String       @id @default(uuid())
  key               String       @unique
  number            Int
  projectId         String
  sprintId          String?
  title             String
  description       String       @default("")
  stepsToReproduce  String       @default("")
  type              IssueType    @default(BUG)
  status            IssueStatus  @default(BACKLOG)
  severity          Severity?
  priority          Priority     @default(MEDIUM)
  position          Float        @default(0) // ordering inside a board column
  reporterId        String
  assigneeId        String?
  aiTriage          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint            Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  reporter          User         @relation("IssueReporter", fields: [reporterId], references: [id])
  assignee          User?        @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events            IssueEvent[]
  testCases         TestCase[]

  @@unique([projectId, number])
  @@index([projectId, sprintId, status, position])
  @@index([assigneeId])
}

/// Audit trail of every status change (who moved what, when).
model IssueEvent {
  id         String       @id @default(uuid())
  issueId    String
  actorId    String
  type       String // "created" | "status_changed" | "triaged" | "updated"
  fromStatus IssueStatus?
  toStatus   IssueStatus?
  message    String       @default("")
  createdAt  DateTime     @default(now())
  issue      Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor      User         @relation(fields: [actorId], references: [id])

  @@index([issueId, createdAt])
}

model TestCase {
  id        String         @id @default(uuid())
  issueId   String
  title     String
  steps     Json // string[]
  expected  String         @default("")
  source    TestCaseSource @default(MANUAL)
  createdAt DateTime       @default(now())
  issue     Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}
